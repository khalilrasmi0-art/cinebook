# CineBook Environment Configuration
# =================================

# Database (Neon Serverless PostgreSQL from Vercel Marketplace)
# Example: postgresql://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require
DATABASE_URL="postgresql://neondb_owner:npg_placeholder@ep-cool-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Vercel Cron Secret (Secures /api/cron/release-holds)
CRON_SECRET="cinebook_cron_super_secure_secret_token_123"

# Authentication
# Secret used for signing JWT tokens and session verification
JWT_SECRET="cinebook_super_secret_jwt_key_development_32_bytes_long_min"
AUTH_COOKIE_NAME="cinebook_session"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe Payment Provider (Test Mode)
# Test keys from Stripe Dashboard (pk_test_... and sk_test_...)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_sample51OxxxxMockPublishableKeyForCineBookTestMode"
STRIPE_SECRET_KEY="sk_test_sample51OxxxxMockSecretKeyForCineBookTestMode"
STRIPE_WEBHOOK_SECRET="whsec_sampleMockWebhookSecretForTesting"

# Vercel Blob Storage (Optional for uploaded movie banners & cinema assets)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_mock_token_for_deployment"
